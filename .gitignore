api_keys.json

# Large downloaded/generated data -- not source, shouldn't be tracked
*.osm.pbf
_network_cache/
_worldpop_cache/
examples/outputs/
examples/_network_cache/
examples/_worldpop_cache/

# Ad-hoc verification screenshots generated while testing map features
/*.png

# Internal method/research notes -- not shipped with the package
documentation/

# ===== Processing results are never tracked (only code) =====
# Anything a run produces -- data, tiles, maps, caches, logs, downloaded feeds / OSM extracts, audit tables -- stays local
# and is regenerable by re-running the code. Test fixtures under tests/ are code assets and stay trackable.

# Result / raw-data / cache file types (anywhere in the repo)
*.parquet
*.geoparquet
*.gpkg
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.pmtiles
*.mbtiles
*.pbf
*.osm.pbf
*.tif
*.tiff
*.npy
*.npz
*.pkl
*.pickle
*.feather
*.h5
*.hdf5
*.zip
*.log
nohup.out
*.tmp
*.part
.cache/
*_cache/
_network_cache*/
pycensus_cache/

# Generated maps and audit/summary tables
map.html
combined_map.html
*_map.html
feed_report.json
feed_exceptions.csv
feed_audit.csv
feed_size_audit.csv
feeds_dropped_by_analysis_date.csv
score_audit.csv
ptlos_by_state.csv
stops_signature.txt
h3_scheme_v*.txt

# Secrets / local configuration
api_keys.json
*.env
.env

# Run output folders (anchored at the repo root)
/data/
/output/
/outputs/
/results/
/figures/
/logs/
/tiles/

# Test fixtures are code assets: keep them trackable even though they match the types above.
!tests/**

# compiled by transitlos.flex.core on first import
_flexcore*.so

# compiled Python, also inside the whitelisted folders above (tests/**)
**/__pycache__/
*.pyc

# ===== Local only: never in the public repository =====
# API keys and credentials
api_keys.json
*.env
.env
*.key
*.pem
# notes about this machine and its processes (hosting, uploads, runs, local paths): keep them as *.local.md or under local/
*.local.md
/local/
# hosting / upload scripts (the maps' hosting lives outside the repositories)
/hosting/
**/deploy_*.py
**/dep_*.py
# coding-agent session files
.claude/
CLAUDE.local.md

# literature notes and the reasoning behind the scoring (kept locally for now)
/documentation/
/report/
